{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"layout": {
			"contentSize": "1372px",
			"wideSize": "1372px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"link": false,
			"palette": [
				{ "slug": "dark", "name": "Anthrazit", "color": "#383e42" },
				{ "slug": "orange", "name": "Orange", "color": "#ff6a00" },
				{ "slug": "panel", "name": "Hellgrau", "color": "#eef2f2" },
				{ "slug": "white", "name": "Weiss", "color": "#ffffff" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"fontFamilies": [
				{
					"slug": "roboto",
					"name": "Roboto",
					"fontFamily": "Roboto, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Roboto",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/roboto-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Roboto",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/roboto-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.875rem" },
				{ "slug": "medium", "name": "Normal", "size": "1rem" },
				{ "slug": "large", "name": "Gross", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Titel klein", "size": "clamp(1.4rem, 2.4vw, 2.07rem)" },
				{ "slug": "xx-large", "name": "Titel", "size": "clamp(1.6rem, 3vw, 2.44rem)" }
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": false,
			"units": [ "px", "rem" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "8px" },
				{ "slug": "30", "name": "S", "size": "16px" },
				{ "slug": "40", "name": "M", "size": "32px" },
				{ "slug": "50", "name": "L", "size": "56px" },
				{ "slug": "60", "name": "XL", "size": "90px" }
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--roboto)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--orange)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "32px",
						"bottom": "14px",
						"left": "32px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "#ff7d22"
					}
				}
			}
		}
	}
}
