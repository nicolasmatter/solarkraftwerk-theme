{
	"apiVersion": 3,
	"name": "sk/products",
	"title": "Produkte-Sektion",
	"category": "solarkraftwerk",
	"icon": "screenoptions",
	"description": "Zeigt Produkte aus dem Bereich „Produkte“ als Vorschau oder vollständiger Katalog nach Gruppen.",
	"attributes": {
		"heading": { "type": "string", "default": "Produkte und Leistungen" },
		"mode": { "type": "string", "default": "teaser" },
		"limit": { "type": "number", "default": 2 },
		"ids": { "type": "array", "items": { "type": "number" }, "default": [] },
		"linkText": { "type": "string", "default": "Mehr sehen" },
		"linkUrl": { "type": "string", "default": "" },
		"editorPreview": { "type": "boolean", "default": false },
		"align": { "type": "string", "default": "full" }
	},
	"supports": { "html": false, "align": [ "full" ], "anchor": true },
	"editorScript": "sk-block-products-editor",
	"render": "file:./render.php"
}
