		"showCta": { "type": "boolean", "default": true },
		"align": { "type": "string", "default": "full" }
	},
	"supports": { "html": false, "align": [ "full" ] },
	"editorScript": "sk-block-hero-editor",
	"render": "file:./render.php"
}
