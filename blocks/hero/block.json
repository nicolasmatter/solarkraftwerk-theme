{
	"apiVersion": 3,
	"name": "sk/hero",
	"title": "Seitenkopf (Hero)",
	"category": "solarkraftwerk",
	"icon": "cover-image",
	"description": "Grosses Titelbild mit Seitentitel, Untertitel und optionalem Offerte-Button.",
	"attributes": {
